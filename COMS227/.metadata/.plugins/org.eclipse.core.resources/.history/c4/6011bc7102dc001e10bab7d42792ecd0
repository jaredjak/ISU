package lab5;

import java.util.Scanner;

public class Initials {
	
	public static String nameInitials(String fullName) {
		String initials = "";
		Scanner in = new Scanner(fullName);
		
		while (in.hasNext()) {
			String name = in.next();
			initials = initials + name.charAt(0);
		}
		return initials; 
	}

	public static void main(String [] args) {
		String name = "J Krug Is The Goat";
		System.out.println("Expected: JKITG" + " Actual: " + nameInitials(name));
	}
}
