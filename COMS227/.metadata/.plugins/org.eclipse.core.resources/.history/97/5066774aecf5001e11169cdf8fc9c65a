	// Given an array of ints. determine whether the array is a permutation of the numbers 0 through n - 1, 
	// where n is the length of the array.
	public static boolean isPermutation(int[] arr) {
		for (int i = 0; i < arr.length; i++) {
			for (int j = i+1; j < arr.length; j++ ) {
				if (arr[i] == arr[j]) {
					return false;
				}
			}
		}
		return true;
	}
	
