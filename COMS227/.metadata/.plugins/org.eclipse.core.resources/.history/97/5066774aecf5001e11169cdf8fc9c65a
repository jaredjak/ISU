	public static int[][] rightShifts(int[] arr) {
		int n = arr.length;
		int[][] shiftTable = new int[n][n];
		
		for (int i = 0; i < n; i++) {
			for (int j = i; j < n; j++) {
				int index = j - i;
				shiftTable[i][j] = arr[index];
			}
		}
		return shiftTable;
	}
	
	public static int[][] leftShifts(int[] arr) {
		int n = arr.length;
		int[][] shiftTable = new int[n][n];
		
		for (int i = 0; i < n; i++) {
			for (int j = 0; j < n; j++) {
				int index = j - i;
				if (index >= 0 && index < n - 1) {
					shiftTable[i][j] = arr[index];
				}
				else {
					shiftTable[i][j] = 0;
				}
			}
		}
		return shiftTable;
	}
	
	public static String blankVowelsV2(String str) {
		String newWord = "";
		String vowels = "AEIOUaeiou";
		for (int i =0; i < str.length(); i++) {
			String temp = str.substring(i, i +1);
			if (vowels.contains(temp)) {
				newWord += "_";
			} else {
				newWord += temp;
			}
		}
		return newWord;
	}
	
