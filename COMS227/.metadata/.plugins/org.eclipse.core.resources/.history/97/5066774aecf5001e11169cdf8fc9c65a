	// Given an ArrayList of integers, determine whether they are in increasing order
	public static boolean incOrder(ArrayList<Integer> arr) {
		for (int i = 1; i < arr.size(); i++) {
			if (arr.get(i) < arr.get(i-1)) {
				return false;
			}
		}
		return true;
	}
	
