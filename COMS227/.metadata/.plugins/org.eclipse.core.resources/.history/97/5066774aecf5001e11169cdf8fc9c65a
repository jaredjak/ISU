	// Problem 1a
	// Given an array of doubles, return the average
	public static double averageOfDoubles(double[] arr) {
		double avg = 0;
		for (int i = 0; i < arr.length; i++) {
			avg += arr[i];
		}
		avg = avg/arr.length;
		return avg;
	}
	
	// Problem 1b
	// Given a sentence, find and return the longest word
	public static String findLongestWord(String str) {
		String longest = "";
		str.replaceAll("[.]", "");
		String[] words = str.split(" ");
		
		longest = words[0];
		for (int i = 0; i < words.length; i++) {
			if (words[i].length() > longest.length()) {
				longest = words[i];
			}
		}
		return longest;
	}
	
	// Problem 1c
	// Given a string, return the string with all spaces and non-alphabetic characters replaced
	// by the character '#'
	public static String replaceNonAlphabet(String str) {
		for (int i = 0; i < str.length() ; i++) {
			char c = str.charAt(i);
			if (!Character.isAlphabetic(c)) {
				str = str.replace(c, '#');

			}
		}
		return str;
	}
	
	// Problem 1d
	// Interest is added to the balance of a savings account each month. Write a method that, given an annual interest rate
	// and an initial balance, determines how many months it takes for the balance to double;
	public static int doubleTime(double rate, double balance) {
		int month = 0;
		double tempBalance = balance;
		
		while (balance * 2 >= tempBalance) {
			tempBalance += tempBalance*(rate/100);
			month++;
		}
		return month;
	}
	
