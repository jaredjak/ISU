package exam1Review;

public class insertionSort {

	
	public static void insertionSort(int[] arr) {
		for (int i = 1; i < arr.length; i++) {
			int target = arr[i];
			int j = i - 1;
			while (j >= 0 && target < arr[j]) {
				--j;
			}
			arr[j+1] = target;
		}
	}
	
	public static void main(String[] args) {
		int[] arr1 = {4,3,2,1};
		insertionSort(arr1);
		System.out.println();
//		int[] arr2 = {4,3,5,1,2};
//		insertionSort(arr2);
	}
}

