BNARY SEARCH (A, v) // A must be sorted

n = A.size
left = 0
right = n - 1
while left <= right
	mid = (left + right)/2
	if A[mid] == v
		return true
	if v < A[mid]
		right = mid - 1
	else
		left = mid + 1
return false


