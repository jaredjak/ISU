private void percolateUp(int[] data, int current) {
	parent = (current - 1) / 2;
	while (current > 0 && data[current] < data[parent] {
		int temp = data[current];
		data[current] = data[parent];
		data[parent] = temp;
		
		current = parent;
		parent = (current - 1) / 2;
	}
}

