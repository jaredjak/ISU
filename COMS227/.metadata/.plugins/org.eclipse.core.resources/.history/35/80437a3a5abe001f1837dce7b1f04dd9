protected Node Successor(Node n) {
	if (n == null) {
		return null;
	}
	else if (n.right != null) {
		Node current = n.right;
		while (current.left != null) {
			current = current.left;
		}
		return current;
	}
	else if (n.right == null) {
		Node current = n.parent;
		Node child = n;
		while (current != null && current.right == child) {
			child = current;
			current = current.parent;
		}
		return current;
	}
}

