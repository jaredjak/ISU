protected Node findEntry(E key) {
	Node current = root; 
	while (current != null) {
		int result = key.compareto(current.data);
		
		if (result == 0) {
			return current;
		}
		else if (result > 0) {
			current = current.left;
		}
		else if (result < 0) {
			current = current.right;
		}
	}
	return null;
}

