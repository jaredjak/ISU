package nestedLoops;

public class NestedLoops {

	public static void main(String[] args) {
		String aString = "Goodbye, World...";
		for (int i = 0; i < aString.length(); i++) {
			for (int j = 0; j < aString.length(); j++) {
				System.out.println("(" + aString.charAt(i) + ", " + aString.charAt(j) + ")");
			}
		}
		
