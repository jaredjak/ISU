package forLoops;

import java.util.Scanner;

public class ForLoop {

	/**
	 * Counts the number of Ts in a string
	 * @param input input to count the number of stirngs in
	 * @return number of Ts
	 */
	public static int countTs(String input) {
		int count = 0;
		
		for(int i = 0; i < input.length(); i++) {
			if (input.charAt(i) == 'T') {
				count++;
			}
		}
		return count;
	}
	
