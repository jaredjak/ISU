package recursion;

public class Recursion {

	public static void countUp(int n) {
		// Base Case
		if (n <= 0) {
			return;
		}
		// Recursion
		countUp(n - 1);
		System.out.println(n);
	}
	
	/**
	 * n1 = n * (n - 1)
	 * @param n
	 * @return 
	 */
	public static int fac(int n) {
		if (n <= 1) {
			return 1;
		}
		return n * fac(n-1);
	}
	
	public static int fib(int n)
	
