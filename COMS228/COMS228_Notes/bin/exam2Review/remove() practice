// Linked Iterator
private class LinkedIterator implements Iterator <E> {
	@Override
	public void remove() {
		if pending == null
			IllegalStateException
		if pending.next != null
			pending.previous.next = pending.next;
		if pending.previous != null
			pending.next.previous = pending.previous
		if pending == head
			head = pending.next
			
		--size
		pending = null
	}




// Iterator
public void remove() {	
	if !canRemove
		throw IllegalStateException
	
	for i = cursor; i < size; i++
		data[i-1] = data[i]
		
	data[size-1] = null
	--size
	--cursor
	canRemove = false
}
		
	
	
		
// Doubly Linked Iterator
void remove(E item) {
	if direction == 0
		throw IllegalStateException
		
	if direction == 1
		Node n = cursor.next
		//unlink
		cursor.previous.next = cursor.next
		cursor.next.previous = cursor.previous
		cursor = n
	else if direction == -1
		cursor.previous = cursor.previous.previous
		cursor.previous.next = cursor
		--index;
		
	--size
	direction = 0
}
		
		