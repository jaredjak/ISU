  /**
   * HELPER METHOD
   * Used to connect nodes together.
   * Happens multiple times so an independent method is justified to prevent duplicate code
   */
  private void connect(Node current, Node nextN) {
	  nextN.previous = current;
	  nextN.next = current.next;
	  current.next.previous = nextN;
	  current.next = nextN;
  }
  
  /**
   * HELPER METHOD
   * Used to get the node and it's offset for ease of access and easily readable code
   */
  private NodeInfo getNodeInfo(int pos) {
	  if (pos == -1) {
		  return new NodeInfo(head, 0);
	  }
	  if (pos == size) {
		  return new NodeInfo(tail, 0);
	  }
	  
	  Node current = head.next;
	  int index = current.count - 1;
	  
	  while (current != tail && pos > index) {
		  current = current.next;
		  index += current.count;
	  }
	  int offset = current.count + pos - index - 1;
	  
	  return new NodeInfo(current, offset);
  }
  
