  @Override
  public E remove(int pos)
  {
    // TODO - DONE
	// NOTE:
	// Didn't use the helper method getNodeInfo() because I had already implemented it and didn't want to change anything.
	
	if (pos < 0 || pos >= size) {
		throw new IndexOutOfBoundsException();
	}
	
	Node current = head.next;
	int index = 0;
	while (current != tail && pos >= index + current.count) {
		index += current.count;
		current = current.next;
	}
	
	int offset = pos - index;
	E removed = current.data[offset]; //item to be removed
	current.removeItem(offset); //remove item
	
	if (current.count < nodeSize / 2) {
		Node successor = current.next;
		if (successor != tail) { //mini-merge
			if (successor.count > nodeSize / 2) {
				current.addItem(current.count, successor.data[0]);
				successor.removeItem(0);
			} else { //full-merge
				for (int i = 0; i < successor.count; i++) {
					current.addItem(current.count, successor.data[i]);
				}
				//disconnect the successor
				successor.previous.next = successor.next;
				successor.next.previous = successor.previous;
			}
		}
	}
	
	//checks if current is last node and only has one element. deletes if true
	if (current.count == 0 && current.next == tail && current.previous != head) {
		current.previous.next = current.next;
		current.next.previous = current.previous;
	}
	
	size--;
    return removed;
  }

  /**
   * Sort all elements in the stout list in the NON-DECREASING order. You may do the following. 
   * Traverse the list and copy its elements into an array, deleting every visited node along 
   * the way.  Then, sort the array by calling the insertionSort() method.  (Note that sorting 
   * efficiency is not a concern for this project.)  Finally, copy all elements from the array 
   * back to the stout list, creating new nodes for storage. After sorting, all nodes but 
   * (possibly) the last one must be full of elements.  
   *  
   * Comparator<E> must have been implemented for calling insertionSort().    
   */
  public void sort()
  {
	  // TODO - DONE
	  
	  //copy elements into an array
	  E[] elements = (E[]) new Comparable[size];
	  Iterator<E> newIterator = iterator();
	  
	  for (int i = 0; i < size; i++) {
		  elements[i] = newIterator.next();  
	  }
	  
	  //destroy
	  head.next = tail;
	  tail.previous = head;
	  size = 0;
	  
	  //sort
	  insertionSort(elements, new ObjectComparator<>());	  
  }
  
  /**
   * Sort all elements in the stout list in the NON-INCREASING order. Call the bubbleSort()
   * method.  After sorting, all but (possibly) the last nodes must be filled with elements.  
   *  
   * Comparable<? super E> must be implemented for calling bubbleSort(). 
   */
  public void sortReverse() 
  {
	  // TODO - DONE
	  E[] elements = (E[]) new Comparable[size];
	  Iterator<E> iterator = iterator();
	  
	  for (int i = 0; i < size; i++) {
		  elements[i] = iterator.next();  
	  }
	  
	  //destroy
	  head.next = tail;
	  tail.previous = head;
	  size = 0;
	  
	  bubbleSort(elements);
	  this.addAll(Arrays.asList(elements));
  }
  
