public class MsgTree {

	/**
	 * 
	 */
	public char payloadChar;
	
	/**
	 * 
	 */
	public MsgTree left;
	
	/**
	 * 
	 */
	public MsgTree right;
	
	/**
	 * 
	 */
	private static int staticCharIdx = 0;
	
	
	
	
	/**
	 * Constructor that constructs a MsgTree object using the given string
	 * 
	 * 
	 * 
	 * @param encodingString
	 */
	public MsgTree(String encodingString) {
		
		char current = encodingString.charAt(staticCharIdx++);
		
		if (current == '^') { //internal node
			this.payloadChar = current;
			this.left = new MsgTree(encodingString);
			this.right = new MsgTree(encodingString);
		}
		else { //leaf node
			this.payloadChar = current;
			this.left = null;
			this.right = null;
		}
		
		
	}
	
	public MsgTree(char payloadChar) {}
	
	public static void printCodes(MsgTree root, String code) {}
	
	
}
