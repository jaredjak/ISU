	At end of loop, if !isEmpty(), return false
	
public static boolean parenthesesMatch(String input) {
	char c, c2;
	PureStack<Character> s = new ArrayBasedStack<>();
	for (i = 0; i < input.length(); i++) {
		c = input.charAt(i);
		
		if (c == '(' || c == '[' || c == '{') {
			s.push();
		}
		
		else {
			try {
				c2 = s.pop();
			} catch (NoSuchElementException e) {
				return false;
			}
			
			if ((c == ')' && c2 != '(' )
				|| 
				(c == ']' && c2 != '[' )
				||
				(c == '}' && c2 != '{' )) {
				return false;
			}
		}
	}
	//return true if stack is empty
	//return false if stack is not empty
	return s.isEmpty();
}


