Unlink Node:
- Used for the deletion method for trees
- Specifically, converts a node with 2 children problem into a node with 1 or 0 children problem.

protected void unlinkNode(Node n) {
	// first, convert the 2 children problem into a 1 or 0 children problem
	if (n.left != null && n.right != null) {
		Node s = successor(n);
		n.data = s.data;
		n = s; // deletion target is now the OTHER node searched for
	}
	
	// Find the replacement node if it exists
	Node replacement = null;
	if (n.left != null) {
		replacement = n.left;
	}
	else if (n.right != null) {
		replacement = n.right;
	}
	
	// Check for root replacement
	if (n.parent == null) {
		root = replacement;
	}
	else {
		// Find the direction of the replacement
		if (n == n.parent.left) {
			n.parent.left = replacement;
		}
		else {
			n.parent.right = replacement;
		}
	}
	
	// Re-target the parent link
	if (replacement != null) {
		replacement.parent = n.parent;
	}
	
	--size;
	
} 

