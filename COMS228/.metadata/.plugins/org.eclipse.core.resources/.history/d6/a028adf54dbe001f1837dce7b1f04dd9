BINARY SEARCH TREE METHODS:

Successor Code:
- Finds the successor of a given node n

protected Node successor(Node n) {
	if (n == null) {
		return null;
	}
	else if (n.right != null) {
		Node current = n.right;
		while (current.left != null) {
			current = current.left;
		}
		return current;
	}
	 else if (n.right == null) {
	 	// set current to be the first parent
	 	Node current = n.parent
	 	Node child = n;
	 	while (current != null && current.right == child) {
	 		child = current;
	 		current = current.parent;
	 	}
	 	
	 	return current;
	 }
	 

Predecessor Code:

protected Node successor(Node n) {
	if (n == null) {
		return null;
	}
	else if (n.left != null) {
		Node current = n.left;
		while (current.right != null) {
			current = current.right;
		}
		return current;
	}
	 else if (n.right == null) {
	 	// set current to be the first parent
	 	Node current = n.parent
	 	Node child = n;
	 	while (current != null && current.left == child) {
	 		child = current;
	 		current = current.parent;
	 	}
	 	return current;
	 }


Find Code:
- Compare node to current data to find the desired node

protected Node findEntry( E key) {
	Node current = root;
	while (current != null) {
		int result = key.compareTo(current.data)
		
		if (result == 0) {
			return current;
		}
		else if (result > 0) {
			current = current.left;
		}
		else {
			current = current.right;
		}
	}
	return null;
}
	
Add Code:
- Adds the key
- if no root, key becomes the root

@Override
public boolean add(E key) {
	if (root == null) {
		root = new Node(key, null);
		++size;
		return true;
		
	Node current = root;
	while (true) {
		int result = key.data.compareTo(current);
		if (result == 0) {
			return false;
		else if (comp < 0) {
			if (current.left != null) {
				current = current.left;
			}
			else {
				current.left = new Node(key, current);
				++size;
				return true
			}
		}
		else if (comp > 0) {
			if (current.right != null) {
				current = current.right;
			}
			else {
				current.right = new Node(key, current);
				++size;
				return true
			}
		}
	}
}


