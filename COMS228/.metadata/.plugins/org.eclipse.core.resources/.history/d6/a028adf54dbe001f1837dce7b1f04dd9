HEAP METHODS:

public boolean add(E item) {
	checkCapacity();
	data[size] = item;
	percolateUp(data, comp, size);
	++size;
	return true;
}


public E remove() {
	if (size == 0) {
		throw new NoSucElementException();
	}
	
	E ret = data[0];
	data[0] = data[size - 1];
	data[size - 1] = null;
	--size;
	percolateDown(data, comp, size, 0);
	return ret;
}



percolateUp(data, current)
	parent = (current - 1) / 2
	while (current > 0 && data[current] < data[parent])
		swap data[current] and data[parent]
		current = parent
		parent = (current - 1) / 2
		
		
percolateDown(data, current)
	child = 2 * current + 1
		
	while (child < size)
		if (child +1 < size)
			if data[child] > data[child+1]
				child = child +1
		if data[current] > data[child]
			swap data[current] and data[child]
		current = child
		child = 2 * current + 1






