	@Test
	public void testNextAfterAdd() {
	    st.add('A');
	    st.add('B');
	    ListIterator<Character> iterator = st.listIterator();
	    iterator.next(); // Moves to 'A'
	    iterator.add('C'); // Adds 'C' after 'A', cursor should be after 'C'
	    
	    // Next call should move to 'B'
	    assertEquals('B', iterator.next().charValue());
	}
	
